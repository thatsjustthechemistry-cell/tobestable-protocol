{
  "compilerOptions": {
    "types": ["mocha", "chai"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["es2020"],
    "module": "commonjs",
    "target": "es2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node10",
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "./dist",
    "ignoreDeprecations": "6.0"
  },
  "include": ["tests/**/*"]
}
